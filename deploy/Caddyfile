{
    admin off
    servers {
        timeouts {
            read_header 10s
            read_body 10s
            write 30s
            idle 60s
        }
    }
}

mia-foyer.com {
    encode zstd gzip
    request_body {
        max_size 2KB
    }
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
    }
    @game path /recommander /recommander/*
    handle @game {
        reverse_proxy app:8080 {
            header_up X-Forwarded-For {remote_host}
        }
    }
    handle / {
        redir /recommander 308
    }
    handle {
        respond 404
    }
}

www.mia-foyer.com {
    redir https://mia-foyer.com{uri} 308
}
